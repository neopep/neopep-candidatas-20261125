{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/neo",
      "destination": "/"
    },
    {
      "source": "/neo/",
      "destination": "/index.html"
    },
    {
      "source": "/neo/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/neo/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/neo/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "release/preparacao-paridade-producao-20261122": true,
      "release/ciclo-aprovado-20261125": false,
      "homologacao/ciclo-completo-2026-11-24": false,
      "fix/pacote-final-20261125": false,
      "preparacao/auditoria-final-teste-20261125": false,
      "preparacao/auditoria-final-producao-20261125": false
    }
  }
}
