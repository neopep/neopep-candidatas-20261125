{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-staging.cjs && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/neo",
      "destination": "/index.html"
    },
    {
      "source": "/neo/",
      "destination": "/index.html"
    },
    {
      "source": "/neo/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/neo/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/neo/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "desenvolvimento/calculadora-ajustes-lote": false,
      "desenvolvimento/ajuste-010-04-editor-custos": false,
      "desenvolvimento/ajuste-010-05-dashboard-financeiro": false,
      "homologacao/loja-010-04-010-05": false,
      "desenvolvimento/ajuste-010-06-conciliacao": false,
      "desenvolvimento/ajuste-011-gerenciamento-massa": false,
      "homologacao/ciclo-completo-2026-11-24": false,
      "fix/pacote-final-teste-20261125": false,
      "preparacao/auditoria-final-teste-20261125": false,
      "preparacao/auditoria-final-producao-20261125": false
    }
  }
}
